+#!/usr/bin/env python3
+"""Build browser-ready Gate 3A replay snapshots and a research-index entry from committed artifacts.
+
+Visualization-only projection (see visualization/README.md invariants). Reads the frozen plan,
+the manifests, the archived events and the committed audits; writes nothing outside
+visualization/epistemic-hive/public/data/gate3a/. Never an input to execution.
+
+Outputs:
+  public/data/gate3a/index.json                     one research-index entry for EXP-003 / Gate 3A
+  public/data/gate3a/<set_id>.json                  one replay file per arm and stage (8 files)
+  public/data/gate3a/manifest.json                  the list of files above with sha256 of each
+
+World and event shape follow tools/build-replay-snapshot.mjs (the Gate 2B replay) so an app that
+reads generatedReplay can read these with the same accessors, plus the fields Gate 3A adds:
+  world: stage, topology, rounds, hops (firings between two scout firings), agents, edges
+  event: receivers (list; `receiver` keeps the first for compatibility), cycle, referencePA,
+         certaintyExcess, kind (at_reference | discount | inflation), redundantRootExposures,
+         agentAsSource, inboundAgentAsSource, erosion, leg (bounce B only: outward | return)
+
+Usage (from collective-agent-epistemics/):
+  python visualization/epistemic-hive/tools/build_gate3a_snapshot.py
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve()
+PROJECT = HERE.parents[3]          # collective-agent-epistemics/
+sys.path.insert(0, str(PROJECT))
+
+from experiments.EXP_003.topology import get_topology  # noqa: E402  (frozen runtime, read-only import)
+
+EXP003 = PROJECT / "experiments" / "EXP_003"
+AUDITS = EXP003 / "audits" / "gate_3a"
+OUT = HERE.parents[1] / "public" / "data" / "gate3a"
+TOL = 1e-6
+STAGES = ("set_001", "set_002")
+HOPS = {"solo": 1, "dyad": 2, "ring": 3, "bounce": 4}
+LABELS = {"ring": "Ring control", "solo": "Solo control", "dyad": "Dyad", "bounce": "Bounce"}
+
+
+def sha256_file(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def rel(path: Path) -> str:
+    return path.resolve().relative_to(PROJECT.resolve()).as_posix()
+
+
+def load(path: Path):
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def certainty_excess(p_a: float, reference: float, observed: str) -> float:
+    p_obs = p_a if observed == "A" else 1.0 - p_a
+    return round(p_obs - max(reference, 1.0 - reference), 6)
+
+
+def kind(ce: float) -> str:
+    if abs(ce) <= TOL:
+        return "at_reference"
+    return "inflation" if ce > 0 else "discount"
+
+
+def project_event(record: dict, observed: str, topology: str) -> dict:
+    lineage = record["actual_lineage"]
+    metrics = record["metrics"]
+    prov = record.get("provenance") or {}
+    receivers = list(record.get("receivers") or [])
+    ce = certainty_excess(float(metrics["p_a"]), float(metrics["reference_p_a"]), observed)
+    event = {
+        "id": record["visible_message_id"],
+        "condition": record["condition"],
+        "sender": record["sender"],
+        "receiver": receivers[0] if receivers else None,
+        "receivers": receivers,
+        "cycle": record.get("cycle"),
+        "message": record["agent_message"]["content"],
+        "answer": record["model_output"]["answer"],
+        "confidence": metrics["confidence"],
+        "pA": metrics["p_a"],
+        "referencePA": metrics["reference_p_a"],
+        "certaintyExcess": ce,
+        "kind": kind(ce),
+        "brierScore": metrics["brier_score"],
+        "roots": lineage["actual_roots"],
+        "derivedFrom": lineage["derived_from"],
+        "depth": lineage["inference_depth"],
+        "redundantRootExposures": lineage.get("redundant_root_exposures"),
+        "newExternalEvidence": lineage["new_external_evidence"],
+        "responseReused": record.get("response_reused", False),
+        "agentAsSource": bool(prov.get("agent_as_source")),
+        "inboundAgentAsSource": bool(prov.get("inbound_agent_as_source")),
+        "erosion": prov.get("erosion_count"),
+        "sameRootRegrounding": (
+            record["sender"] == "A" and lineage["actual_roots"] == ["E1"]
+            and lineage["new_external_evidence"] is False and "Direct observation:" in record["model_visible_input"]
+        ),
+    }
+    if topology == "bounce" and record["sender"] == "B":
+        event["leg"] = "outward" if receivers == ["C"] else "return"
+    return event
+
+
+def build() -> None:
+    plan_path = EXP003 / "GATE_3A_PLAN_v0.1.json"
+    plan = load(plan_path)
+    if plan.get("status") != "FROZEN":
+        raise SystemExit("Gate 3A plan is not FROZEN; refusing to project an unfrozen gate")
+    OUT.mkdir(parents=True, exist_ok=True)
+    written: dict[str, str] = {}
+    totals = {}
+    arm_summaries = []
+
+    for stage in STAGES:
+        corpus_path = AUDITS / f"EXP_003_GATE_3A_{stage.upper()}_CORPUS_AUDIT_v0.1.json"
+        primary_path = AUDITS / f"EXP_003_GATE_3A_{stage.upper()}_PRIMARY_OUTCOME_AUDIT_v0.1.json"
+        corpus, primary = load(corpus_path), load(primary_path)
+        if corpus["status"] != "PASS" or primary["status"] != "COMPLETE":
+            raise SystemExit(f"{stage}: audits not closed (corpus {corpus['status']}, primary {primary['status']})")
+        stage_events = stage_calls = 0
+        for arm in plan["arms"]:
+            if arm["stage"] != stage:
+                continue
+            topo = get_topology(arm["topology"])
+            manifest_path = EXP003 / arm["manifest"]
+            manifest = load(manifest_path)
+            record = corpus["sets"][arm["set_id"]]
+            worlds = []
+            for w in manifest["worlds"]:
+                audit_world = next(x for x in record["worlds"] if x["canonical_id"] == w["canonical_id"])
+                attempt = audit_world["complete"][0]
+                attempt_dir = EXP003 / "results" / "archive" / "gate_3a" / arm["set_id"] / w["canonical_id"] / attempt
+                events_path = attempt_dir / "events.jsonl"
+                source = events_path.read_text(encoding="utf-8")
+                if hashlib.sha256(source.encode("utf-8")).hexdigest() != audit_world["raw_file_sha256"]["events.jsonl"]:
+                    raise SystemExit(f"{events_path}: hash differs from the corpus audit record")
+                observed = audit_world["cell"].split("/")[1]
+                records = [json.loads(line) for line in source.splitlines() if line.strip()]
+                conditions = {c: [project_event(r, observed, arm["topology"]) for r in records if r["condition"] == c]
+                              for c in ("free", "lineage", "macro")}
+                for c in conditions.values():
+                    c.sort(key=lambda e: int(e["id"][1:]))
+                paired = [f["answer"] != l["answer"] or f["confidence"] != l["confidence"] or f["pA"] != l["pA"]
+                          for f, l in zip(conditions["free"], conditions["lineage"])]
+                meta = load(attempt_dir / "archive_metadata.json")
+                stage_events += len(records)
+                stage_calls += int(meta.get("actual_model_call_count") or 0)
+                worlds.append({
+                    "id": w["canonical_id"], "seed": w["seed"], "executionOrder": w.get("execution_order"),
+                    "set": arm["set_id"], "setLabel": LABELS[arm["topology"]], "stage": stage,
+                    "topology": arm["topology"], "rounds": arm["rounds"], "hops": HOPS[arm["topology"]],
+                    "agents": list(topo.agents), "edges": topo.edges(),
+                    "truth": audit_world["cell"].split("/")[0], "observed": observed,
+                    "alignment": audit_world.get("alignment"),
+                    "sensorReliability": plan["controlled_configuration"]["sensor_reliability"], "evidenceRoot": "E1",
+                    "finalDifference": paired[-1] if paired else False, "trajectoryDifference": any(paired),
+                    "archivePath": rel(attempt_dir), "attempt": attempt,
+                    "auditPath": rel(primary_path), "corpusAuditPath": rel(corpus_path),
+                    "sourceHash": hashlib.sha256(source.encode("utf-8")).hexdigest(),
+                    "macroStopTriggered": True, "conditions": conditions,
+                })
+            snapshot = {
+                "experiment": "EXP-003", "gate": "3A", "stage": stage, "set": arm["set_id"], "topology": arm["topology"],
+                "sourceManifest": rel(manifest_path), "manifestHash": sha256_file(manifest_path),
+                "planHash": sha256_file(plan_path), "worlds": worlds,
+                "authority": "derived visualization snapshot; not scientific authority",
+            }
+            out = OUT / f"{arm['set_id']}.json"
+            out.write_text(json.dumps(snapshot, indent=1) + "\n", encoding="utf-8")
+            written[out.name] = sha256_file(out)
+            agg = primary["arm_aggregates"][arm["set_id"]]["conditions"]
+            arm_summaries.append({
+                "set": arm["set_id"], "stage": stage, "topology": arm["topology"], "rounds": arm["rounds"], "worlds": len(worlds),
+                "file": out.name,
+                "lineage": {a: {k: v[k] for k in ("events", "discount_events", "inflation_events", "at_reference_events")}
+                            for a, v in agg["lineage"]["agents"].items()},
+                "free": {a: {k: v[k] for k in ("events", "discount_events", "inflation_events", "at_reference_events")}
+                         for a, v in agg["free"]["agents"].items()},
+                "scoutRestorationLineage": agg["lineage"]["A_restoration_rate"],
+                "worldsWithSustainedScoutDeviationLineage": agg["lineage"]["worlds_with_sustained_A_deviation"],
+                "bounceBLegsLineage": agg["lineage"].get("bounce_B_legs"),
+            })
+        totals[stage] = {"worlds": corpus["totals"]["complete_worlds"], "events": stage_events,
+                         "validProviderCalls": stage_calls, "failureRecords": corpus["totals"]["failure_records"]}
+
+    synthesis = load(AUDITS / "EXP_003_GATE_3A_SYNTHESIS_v0.1.json")
+    e = synthesis["expectations"]
+    index = {
+        "schemaVersion": "0.1",
+        "authority": "derived visualization metadata; not scientific authority",
+        "experiment": "EXP-003", "gate": "3A", "status": "CLOSED_UNDER_FROZEN_V0_1_DESIGN",
+        "closureTag": "exp-003-gate3a-closed-v0.1", "protocolTag": "exp-003-protocol-v0.1",
+        "question": ("On the same worlds, the same model on the same day, the same calls and the same depth, how do four "
+                     "communication structures differ in where deviation from the single-root reference occurs and whether "
+                     "the origin corrects it: solo, dyad, ring, bounce?"),
+        "sharedConfiguration": {**plan["controlled_configuration"], "probe": False, "depth": 12, "callsPerWorld": 25},
+        "stages": {s: {"role": "discovery" if s == "set_001" else "replication on 12 new worlds, run regardless of Set 001",
+                       **totals[s]} for s in STAGES},
+        "arms": arm_summaries,
+        "expectations": {k: e[k]["verdicts"] for k in ("E1", "E2", "E3", "E4", "E5")} | {"E6": e["E6"]["verdict"]},
+        "orderingByLineageDiscountRate": e["E6"]["orderings"],
+        "lineageDiscountRates": e["E6"]["rates"],
+        "originInflation": [o for o in synthesis["origin_deviations"] if o["condition"] == "lineage"],
+        "finalState": synthesis["final_state"],
+        "historical": {k: synthesis["historical"][k] for k in ("historical_runs", "historical_distinct_seeds", "contemporary", "historical")},
+        "gateAnswer": ("Repetition alone produced no deviation (solo). Under LINEAGE, discounting increased with structural "
+                       "distance from the source, in the same order in both stages. The origin inflated above the single-root "
+                       "reference at a minority of LINEAGE firings in the ring and bounce, never in the dyad or solo, never under "
+                       "FREE. Final answers never changed. Descriptive only."),
+        "notEstablished": ["Causality", "Population prevalence", "Model generality (one model, one reliability)",
+                           "Whether the LINEAGE discount is epistemic rather than a format effect",
+                           "Which component of the envelope drives origin inflation (Gates 3B and 3C)"],
+        "sourceArtifacts": {
+            "plan": {"path": rel(plan_path), "sha256": sha256_file(plan_path)},
+            **{f"{s}_corpus": {"path": rel(AUDITS / f"EXP_003_GATE_3A_{s.upper()}_CORPUS_AUDIT_v0.1.json"),
+                               "sha256": sha256_file(AUDITS / f"EXP_003_GATE_3A_{s.upper()}_CORPUS_AUDIT_v0.1.json")} for s in STAGES},
+            **{f"{s}_primary": {"path": rel(AUDITS / f"EXP_003_GATE_3A_{s.upper()}_PRIMARY_OUTCOME_AUDIT_v0.1.json"),
+                                "sha256": sha256_file(AUDITS / f"EXP_003_GATE_3A_{s.upper()}_PRIMARY_OUTCOME_AUDIT_v0.1.json")} for s in STAGES},
+            "synthesis": {"path": rel(AUDITS / "EXP_003_GATE_3A_SYNTHESIS_v0.1.json"), "sha256": sha256_file(AUDITS / "EXP_003_GATE_3A_SYNTHESIS_v0.1.json")},
+            "observations": {"path": "research/observations/EXP_003_gate_3a_observations_v0.1.md",
+                             "sha256": sha256_file(PROJECT / "research" / "observations" / "EXP_003_gate_3a_observations_v0.1.md")},
+        },
+    }
+    (OUT / "index.json").write_text(json.dumps(index, indent=1) + "\n", encoding="utf-8")
+    written["index.json"] = sha256_file(OUT / "index.json")
+    (OUT / "manifest.json").write_text(json.dumps({"files": written, "generator": rel(HERE)}, indent=1) + "\n", encoding="utf-8")
+    print(f"wrote {len(written)} files to {rel(OUT)}: " + ", ".join(sorted(written)))
+    print("totals:", json.dumps(totals))
+
+
+if __name__ == "__main__":
+    build()
